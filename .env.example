# Fantoma Docker — copy to .env and fill in values
# cp .env.example .env

# OpenRouter cloud LLM (backup when local LLM busy)
OPENROUTER_KEY=sk-or-your-openrouter-key-here

# CAPTCHA solving (optional). Docker passes these on as CAPTCHA_API /
# CAPTCHA_KEY; outside Docker set FANTOMA_CAPTCHA_API / FANTOMA_CAPTCHA_KEY.
# Services: capsolver, 2captcha, anticaptcha, capmonster.
CAPTCHA_SERVICE=capsolver
CAPSOLVER_KEY=your-captcha-service-key-here

# Optional: limit which sites the browser may contact (comma-separated).
# "example.com" also covers its subdomains. Enforced on every request,
# including images and scripts, so a page cannot send data elsewhere.
# FANTOMA_ALLOWED_DOMAINS=example.com,docs.example.org
# FANTOMA_BLOCKED_DOMAINS=ads.example.net
